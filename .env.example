# AI Website Builder Environment Variables
# ------------------------------------------------------------------------------
# 1. AI Provider Credentials
# Server-side Gemini API key (optional). If not configured, users can supply
# their own API keys in the client-side Provider Settings modal.
GEMINI_API_KEY=

# 2. Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# 3. Security & CORS Configuration
# Comma-separated list of allowed origins for cross-origin resource sharing (CORS).
# In development, localhost:3000, 127.0.0.1:3000, and 0.0.0.0:3000 are permitted by default.
# For production deployments, specify the exact domain(s) of the application.
# Example: ALLOWED_ORIGINS=https://builder.yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=
